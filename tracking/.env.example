# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored -- never commit your actual token.

# Your site's URL (same one in the browser's address bar).
SITE_URL=https://www.goalieiqanalytics.com

# Must match the YOLO_WORKER_TOKEN environment variable set in Vercel.
# Generate a long random value once, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
YOLO_WORKER_TOKEN=

# Optional overrides -- uncomment to change from the defaults.
# YOLO_DEVICE=cpu
# YOLO_PLAYER_WEIGHTS=yolov8n.pt
# YOLO_PUCK_WEIGHTS=
# YOLO_STRIDE=1
