      "css": ".ds-photo{background:#121412;padding:24px;}.ds-btn-gold{border:0;background:#E8B923;color:#121412;padding:13px 22px;border-radius:6px;cursor:pointer;font-family:\"Archivo\",system-ui,sans-serif;font-size:16px;font-weight:800;font-style:italic;font-stretch:80%;text-transform:uppercase;letter-spacing:.03em;outline:1.5px dashed rgba(18,20,18,.55);outline-offset:-5px;transition:background .18s cubic-bezier(.16,1,.3,1);}.ds-btn-gold:hover{background:#F4C93A;}.ds-btn-gold:focus-visible{outline:2px solid #E8B923;outline-offset:2px;}"
