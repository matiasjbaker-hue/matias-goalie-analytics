      "refersTo": "button-primary",
      "description": "Ink face, pad-lettered caps, dashed gold inner stitch; hover pine.",
      "html": "<button class=\"ds-btn-primary\">Create account</button>",
      "css": ".ds-btn-primary{border:0;background:var(--ink,#121412);color:var(--pu,#F4F5F1);padding:13px 22px;border-radius:6px;cursor:pointer;font-family:\"Archivo\",system-ui,sans-serif;font-size:16px;font-weight:800;font-style:italic;font-stretch:80%;text-transform:uppercase;letter-spacing:.03em;line-height:1.1;outline:1.5px dashed rgba(232,185,35,.9);outline-offset:-5px;transition:background .18s cubic-bezier(.16,1,.3,1),transform .18s cubic-bezier(.16,1,.3,1);}.ds-btn-primary:hover{background:var(--pine,#0F4A35);}.ds-btn-primary:active{transform:translateY(1px);}.ds-btn-primary:focus-visible{outline:2px solid var(--gold,#E8B923);outline-offset:2px;}"
    },
    {
      "name": "Primary Button on Photo",
